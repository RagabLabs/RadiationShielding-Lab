{
  "name": "radiation-shielding-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scientific": "vitest run tests/physics.test.ts tests/data.test.ts",
    "test:e2e": "playwright test",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "validate:scientific": "node --import tsx scripts/scientific-report.ts",
    "import:data": "python3 scripts/import_nist.py",
    "preview": "vite preview --host 0.0.0.0",
    "smoke:standalone": "node scripts/smoke-standalone.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "jspdf": "4.2.1",
    "lucide-react": "1.57.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "tsx": "4.23.15",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.2",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
