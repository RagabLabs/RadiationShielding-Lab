    {
      "section": "Equations",
      "name": "Linear coefficient",
      "value": "mu = (mu/rho) * rho",
      "unit": ""
    },
    {
      "section": "Equations",
      "name": "Uncollided transmission",
      "value": "T = exp(-mu*x)",
      "unit": ""
    },
    {
      "section": "Equations",
      "name": "Inverse thickness",
      "value": "x = -ln(T)/mu",
      "unit": ""
    },
    {
      "section": "Equations",
      "name": "Characteristic layers",
      "value": "HVL = ln(2)/mu; TVL = ln(10)/mu; lambda = 1/mu",
      "unit": ""
    },
    {
      "section": "Equations",
      "name": "Layers",
      "value": "T = exp(-sum(mu_i*x_i))",
      "unit": ""
    },
    {
      "section": "Equations",
      "name": "Photon fluence ratio",
      "value": "sum(w_j*T_j)/sum(w_j)",
      "unit": ""
    },
    {
      "section": "Equations",
      "name": "Energy fluence ratio",
      "value": "sum(E_j*w_j*T_j)/sum(E_j*w_j)",
      "unit": ""
    },
    {
      "section": "Assumptions",
      "name": "Model",
      "value": "Homogeneous layers, monoenergetic exponential attenuation per spectral line, fixed source coefficients, independent-atom mixture rule. No geometry correction, buildup, scattered/secondary photons or dose estimate.",
      "unit": ""
    },
    {
      "section": "Warnings",
      "name": "Warning 1",
      "value": "The calculations primarily describe uncollided photon attenuation under stated model assumptions. They are not a substitute for validated radiation transport simulations, professional shielding design, or regulatory radiation protection assessments.",
      "unit": ""
    },
    {
      "section": "Warnings",
      "name": "Warning 2",
      "value": "Interaction contributions use a separate XCOM dataset. They are checked against its own total, not against SRD 126. Small source differences are expected.",
      "unit": ""
    },
    {
      "section": "Warnings",
      "name": "Warning 3",
      "value": "HVL, TVL and mean free path shown are reference monoenergetic properties at the selected reference energy, not effective polyenergetic values.",
      "unit": ""
    }
